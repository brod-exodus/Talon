{
  "name": "talon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "next build",
    "backup:database": "bash ./scripts/backup-database.sh",
    "backup:drill": "bash ./scripts/drill-database-restore.sh",
    "backup:status": "node --experimental-strip-types scripts/check-recovery-readiness.ts",
    "backup:verify": "bash ./scripts/verify-database-backup.sh",
    "benchmark:capacity": "node --experimental-strip-types scripts/benchmark-capacity.ts",
    "benchmark:concurrency": "node --experimental-strip-types scripts/benchmark-worker-concurrency.ts",
    "dev": "next dev",
    "export:verify": "node --experimental-strip-types scripts/verify-workspace-export.ts",
    "lint": "eslint . --max-warnings=0",
    "migrations:check": "node --experimental-strip-types scripts/check-migrations.ts",
    "security:audit": "pnpm audit --audit-level=high",
    "smoke:local": "bash ./scripts/smoke-local.sh",
    "smoke:production": "bash ./scripts/smoke-production.sh",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm migrations:check && pnpm lint && pnpm typecheck && pnpm test",
    "start": "next start",
    "test": "pnpm test:unit && pnpm test:routes",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "node --test --experimental-strip-types tests/*.test.ts",
    "test:routes": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "latest",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@supabase/supabase-js": "^2.97.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "framer-motion": "12.23.24",
    "input-otp": "1.4.1",
    "lucide-react": "^0.454.0",
    "next": "15.5.23",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-day-picker": "9.8.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22.20.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "lodash@<4.18.1": "4.18.1",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.18": "8.5.26",
      "sharp@<0.35.0": "0.35.3",
      "tar@<7.5.19": "7.5.22",
      "ws@<8.21.0": "8.21.3"
    }
  }
}
